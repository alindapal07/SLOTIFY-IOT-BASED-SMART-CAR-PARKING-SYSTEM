# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Conceptually: MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
QR_SECRET=your_hex_encoded_qr_secret_key_here

# Nodemailer / Email Service
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
INNGEST_EMAIL=your_inngest_admin_email@gmail.com

# Inngest Background Jobs
INNGEST_EVENT_KEY=your_inngest_event_key_here
